---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';

const lastUpdated = 'June 5, 2026';

const sections = [
  {
    heading: 'Information we collect',
    body: [
      'When you use this website or contact us, we may collect: your name, email address and phone number when you submit a contact or appointment form; the reason for your visit as you describe it; and basic technical information such as browser type and pages visited, used to keep the site working properly.',
    ],
  },
  {
    heading: 'How we use your information',
    body: ['We use the information you provide to:'],
    items: [
      'Respond to your inquiry and schedule appointments',
      'Verify insurance coverage when you ask us to',
      'Send appointment confirmations and reminders',
      'Improve our website and the way we communicate',
    ],
  },
  {
    heading: 'Health information (HIPAA)',
    body: [
      'Protected health information (PHI) shared in the course of your care is governed by our Notice of Privacy Practices under HIPAA, which you receive at your first visit and can request at any time. This website is not intended to collect medical records — please avoid including detailed medical history in web forms.',
    ],
  },
  {
    heading: 'Sharing of information',
    body: [
      'We do not sell or rent your personal information. We share it only with service providers who help us operate (such as our scheduling and messaging platform), when required by law, or with your explicit consent.',
    ],
  },
  {
    heading: 'Cookies & analytics',
    body: [
      'This site uses only the cookies necessary for it to function. We do not load third-party advertising trackers. Embedded services (such as the booking calendar or maps) load only when you interact with them.',
    ],
  },
  {
    heading: 'Data security & retention',
    body: [
      'Form submissions are transmitted over encrypted connections (HTTPS) and stored in access-controlled systems. We keep inquiry information only as long as needed to assist you, or as required by law.',
    ],
  },
  {
    heading: 'Your rights',
    body: [
      'You may request access to, correction of, or deletion of the personal information we hold about you at any time. Contact us at (801) 555-0100 or through our contact form and we will respond within 30 days.',
    ],
  },
  {
    heading: 'Children',
    body: [
      'This website is not directed at children under 13 and we do not knowingly collect their information online. Care for minors is always coordinated through a parent or legal guardian.',
    ],
  },
  {
    heading: 'Changes to this policy',
    body: [
      'If we update this policy, the new version will be published on this page with a revised date. Significant changes will be highlighted on the site.',
    ],
  },
  {
    heading: 'Contact',
    body: [
      'Orthopedic PI — 1234 Wasatch Boulevard, Salt Lake City, UT 84109. Phone: (801) 555-0100.',
    ],
  },
];
---

<BaseLayout
  title="Privacy policy"
  description="How Orthopedic PI collects, uses and protects your personal information."
>
  <PageHero
    eyebrow="Legal"
    title="Privacy policy"
    subtitle={`How we collect, use and protect your information. Last updated ${lastUpdated}.`}
  />

  <section class="container-page section-y">
    <div class="max-w-3xl space-y-12">
      {sections.map((s) => (
        <div class="reveal-up">
          <h2 class="text-2xl">{s.heading}</h2>
          {s.body.map((p) => (
            <p class="mt-4 text-(--color-ink-muted) leading-relaxed">{p}</p>
          ))}
          {s.items && (
            <ul class="mt-4 list-disc pl-5 space-y-2 text-(--color-ink-muted)" role="list">
              {s.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
