---
import { MapPin, Phone, Clock, Accessibility, ArrowUpRight } from 'lucide-react';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import LeadFormSection from '../../components/sections/LeadFormSection.astro';
import CTAStrip from '../../components/sections/CTAStrip.astro';
import { useTranslations } from '../../i18n/utils';
import es from '../../i18n/es.json';

const lang = 'es' as const;
const t = useTranslations(lang);

const hours = es.pages.location.hours.items;
const directionsUrl = 'https://www.google.com/maps/dir/?api=1&destination=1234+Wasatch+Boulevard+Salt+Lake+City+UT+84109';
---

<BaseLayout title={t('pages.location.metaTitle')} description={t('pages.location.subtitle')}>
  <PageHero
    eyebrow={t('pages.location.eyebrow')}
    title={t('pages.location.title')}
    subtitle={t('pages.location.subtitle')}
  />

  <section class="container-page section-y">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-16">
      <div class="space-y-10">
        <div>
          <div class="flex items-center gap-3 text-(--color-accent)">
            <MapPin size={18} strokeWidth={1.5} />
            <p class="text-xs uppercase tracking-[0.18em] text-(--color-ink-muted)">
              {t('pages.location.address.label')}
            </p>
          </div>
          <p class="mt-3 font-display text-2xl text-(--color-ink) leading-snug" style={{ fontVariationSettings: '"opsz" 36' }}>
            {t('pages.location.address.street')}<br />
            {t('pages.location.address.cityState')}
          </p>
          <a
            href={directionsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-(--color-accent) hover:gap-3 transition-all duration-300 ease-(--ease-out-expo)"
          >
            {t('pages.location.directionsCta')}
            <ArrowUpRight size={14} strokeWidth={1.75} />
          </a>
        </div>

        <div>
          <div class="flex items-center gap-3 text-(--color-accent)">
            <Phone size={18} strokeWidth={1.5} />
            <p class="text-xs uppercase tracking-[0.18em] text-(--color-ink-muted)">
              {t('pages.location.phone.label')}
            </p>
          </div>
          <a
            href="tel:+18015550100"
            class="mt-3 inline-block font-display text-2xl text-(--color-ink) hover:text-(--color-accent) transition-colors"
            style={{ fontVariationSettings: '"opsz" 36' }}
          >
            {t('pages.location.phone.value')}
          </a>
        </div>

        <div>
          <div class="flex items-center gap-3 text-(--color-accent)">
            <Clock size={18} strokeWidth={1.5} />
            <p class="text-xs uppercase tracking-[0.18em] text-(--color-ink-muted)">
              {t('pages.location.hours.label')}
            </p>
          </div>
          <dl class="mt-4 space-y-2">
            {hours.map((row) => (
              <div class="flex justify-between py-2 border-b border-(--color-border) text-(--color-ink)">
                <dt>{row.days}</dt>
                <dd class="tabular-nums text-(--color-ink-muted)">{row.time}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div>
          <div class="flex items-center gap-3 text-(--color-accent)">
            <Accessibility size={18} strokeWidth={1.5} />
            <p class="text-xs uppercase tracking-[0.18em] text-(--color-ink-muted)">
              {t('pages.location.parking.label')}
            </p>
          </div>
          <p class="mt-3 text-(--color-ink-muted) leading-relaxed">
            {t('pages.location.parking.description')}
          </p>
        </div>
      </div>

      <div class="aspect-[4/5] lg:aspect-auto lg:min-h-[500px] rounded-(--radius-2xl) border border-(--color-border) bg-(--color-surface-sunken) flex items-center justify-center text-center p-12">
        <div class="max-w-sm">
          <MapPin size={32} strokeWidth={1.25} className="text-(--color-accent) mx-auto" />
          <p class="mt-6 text-(--color-ink-muted) leading-relaxed">
            {t('pages.location.mapPlaceholder')}
          </p>
          <a
            href={directionsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center gap-2 h-12 px-6 rounded-(--radius-md) bg-(--color-ink) text-(--color-ink-inverse) font-medium hover:bg-(--color-accent) transition-colors duration-300 ease-(--ease-out-quart)"
          >
            {t('pages.location.directionsCta')}
            <ArrowUpRight size={16} strokeWidth={1.75} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <LeadFormSection />
  <CTAStrip />
</BaseLayout>
