---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/sections/Hero.tsx';
import Stats from '../../components/sections/Stats.astro';
import Services from '../../components/sections/Services.astro';
import WhyChooseUs from '../../components/sections/WhyChooseUs.astro';
import TestimonialsSection from '../../components/sections/TestimonialsSection.astro';
import FAQ from '../../components/sections/FAQ.astro';
import LeadFormSection from '../../components/sections/LeadFormSection.astro';
import CTAStrip from '../../components/sections/CTAStrip.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('es');

const heroPoster = 'https://images.unsplash.com/photo-1551601651-2a8555f1a136?auto=format&fit=crop&w=1920&q=80';
const heroVideoUrl =
  import.meta.env.PUBLIC_HERO_VIDEO_URL ||
  '/videos/medical-professional-assists-senior-woman-with-arm-2025-12-17-21-06-54-utc.mp4';
---

<BaseLayout transparentHeader>
  <Hero
    client:load
    eyebrow={t('home.heroEyebrow')}
    title={t('home.heroTitle')}
    subtitle={t('home.heroSubtitle')}
    ctaPrimaryLabel={t('home.heroCtaPrimary')}
    ctaPrimaryHref="/es/contact"
    ctaSecondaryLabel={t('actions.call')}
    ctaSecondaryHref="tel:+18015550100"
    scrollHint={t('home.scrollHint')}
    posterImage={heroPoster}
    videoUrl={heroVideoUrl}
  />
  <Stats />
  <Services />
  <WhyChooseUs />
  <TestimonialsSection />
  <FAQ />
  <LeadFormSection />
  <CTAStrip />
</BaseLayout>
