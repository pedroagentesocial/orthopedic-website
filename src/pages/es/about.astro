---
import { Check } from 'lucide-react';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import LeadFormSection from '../../components/sections/LeadFormSection.astro';
import CTAStrip from '../../components/sections/CTAStrip.astro';
import { useTranslations } from '../../i18n/utils';
import es from '../../i18n/es.json';

const lang = 'es' as const;
const t = useTranslations(lang);

const valueKeys = ['trust', 'precision', 'humanity'] as const;
const techList = es.pages.about.techItems;
---

<BaseLayout title={t('pages.about.metaTitle')} description={t('pages.about.intro')}>
  <PageHero
    eyebrow={t('pages.about.eyebrow')}
    title={t('pages.about.title')}
  />

  <section class="container-page section-y">
    <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr] lg:gap-20">
      <p class="text-xl text-(--color-ink-muted) leading-relaxed max-w-2xl">
        {t('pages.about.intro')}
      </p>
      <div class="border-l-2 border-(--color-accent) pl-8">
        <p class="text-sm uppercase tracking-[0.18em] text-(--color-ink-muted)">
          {t('home.stats.eyebrow')}
        </p>
        <p class="mt-4 font-display text-6xl tabular-nums text-(--color-ink) leading-none" style={{ fontVariationSettings: '"opsz" 144' }}>25</p>
        <p class="mt-3 text-(--color-ink-muted)">{t('home.stats.years')}</p>
      </div>
    </div>
  </section>

  <section class="container-page section-y border-t border-(--color-border)">
    <p class="text-sm uppercase tracking-[0.18em] text-(--color-ink-muted)">
      <span class="inline-block w-8 h-px bg-(--color-accent) align-middle mr-2"></span>
      {t('pages.about.valuesEyebrow')}
    </p>
    <h2 class="mt-6 max-w-2xl">{t('pages.about.valuesTitle')}</h2>

    <div class="mt-14 grid gap-12 md:grid-cols-3">
      {valueKeys.map((key, i) => (
        <div class="border-t border-(--color-border) pt-8">
          <p class="font-display text-xs tabular-nums uppercase tracking-[0.2em] text-(--color-ink-subtle)">
            {String(i + 1).padStart(2, '0')}
          </p>
          <h3 class="mt-4 font-display text-2xl tracking-tight" style={{ fontVariationSettings: '"opsz" 36' }}>
            {t(`pages.about.values.${key}.title`)}
          </h3>
          <p class="mt-4 text-(--color-ink-muted) leading-relaxed">
            {t(`pages.about.values.${key}.description`)}
          </p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-page section-y border-t border-(--color-border)">
    <div class="grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-20">
      <div>
        <p class="text-sm uppercase tracking-[0.18em] text-(--color-ink-muted)">
          <span class="inline-block w-8 h-px bg-(--color-accent) align-middle mr-2"></span>
          {t('pages.about.techEyebrow')}
        </p>
        <h2 class="mt-6">{t('pages.about.techTitle')}</h2>
        <p class="mt-6 text-(--color-ink-muted) leading-relaxed">
          {t('pages.about.techDescription')}
        </p>
      </div>
      <ul class="grid gap-3 self-start">
        {techList.map((item) => (
          <li class="flex items-start gap-4 p-5 rounded-(--radius-lg) border border-(--color-border) bg-(--color-surface-elevated)">
            <Check size={20} strokeWidth={1.5} className="text-(--color-accent) mt-0.5 shrink-0" />
            <span class="text-(--color-ink)">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <LeadFormSection />
  <CTAStrip />
</BaseLayout>
