---
import BaseLayout from '../layouts/BaseLayout.astro';
import SendButton from '../components/ui/SendButton.tsx';
import SplashButton from '../components/ui/SplashButton.tsx';
import MagneticButton from '../components/ui/MagneticButton.tsx';
import AnimatedInput from '../components/ui/AnimatedInput.tsx';
import AnimatedTextarea from '../components/ui/AnimatedTextarea.tsx';
import Checkbox from '../components/ui/Checkbox.tsx';
import Tooltip from '../components/ui/Tooltip.tsx';
import Accordion from '../components/ui/Accordion.astro';
import ServiceCard from '../components/ui/ServiceCard.tsx';
import ServiceCardFlip from '../components/ui/ServiceCardFlip.tsx';
import SocialIcons from '../components/ui/SocialIcons.tsx';
import { Bone, Activity, Hand, Footprints, Info } from 'lucide-react';

const services = [
  { title: 'Knee & Hip', description: 'Joint preservation, replacement and minimally invasive surgery for active lives.', icon: 'Footprints', image: 'https://images.unsplash.com/photo-1581595220892-b0739db3ba8c?auto=format&fit=crop&w=900&q=80' },
  { title: 'Spine', description: 'Targeted treatment for disc, nerve and structural conditions.', icon: 'Bone', image: 'https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&w=900&q=80' },
  { title: 'Sports Medicine', description: 'From weekend athletes to professionals — recovery built to last.', icon: 'Activity', image: 'https://images.unsplash.com/photo-1551601651-2a8555f1a136?auto=format&fit=crop&w=900&q=80' },
  { title: 'Hand & Upper Extremity', description: 'Microsurgical precision for hand, wrist and elbow restoration.', icon: 'Hand', image: 'https://images.unsplash.com/photo-1559757148-5c350d0d3c56?auto=format&fit=crop&w=900&q=80' },
];

const iconMap = { Bone, Activity, Hand, Footprints } as const;

const faqItems = [
  { value: 'q1', question: 'Do I need a referral to schedule a visit?', answer: 'No referral is required for most orthopedic consultations. We work directly with you and your primary care physician when needed.' },
  { value: 'q2', question: 'Which insurance plans do you accept?', answer: 'We accept most major insurers in Utah, including Medicare, SelectHealth, Blue Cross, Aetna and United Healthcare. Contact us to verify your specific plan.' },
  { value: 'q3', question: 'How soon can I be seen?', answer: 'Most patients are scheduled within 5 to 10 business days. Urgent cases — including post-injury — are seen within 48 hours when possible.' },
];

const credits = [
  { slug: 'loud-chicken-53', author: 'gharsh11032000', applied: 'SendButton', url: 'https://uiverse.io/gharsh11032000/loud-chicken-53' },
  { slug: 'ugly-dog-26', author: 'AbanoubMagdy1', applied: 'Accordion indicator (+ → —)', url: 'https://uiverse.io/AbanoubMagdy1/ugly-dog-26' },
  { slug: 'green-donkey-82', author: 'WhiteNervosa', applied: 'Checkbox', url: 'https://uiverse.io/WhiteNervosa/green-donkey-82' },
  { slug: 'jolly-emu-80', author: 'alexruix', applied: 'AnimatedInput + AnimatedTextarea', url: 'https://uiverse.io/alexruix/jolly-emu-80' },
  { slug: 'chilly-eagle-55', author: 'PriyanshuGupta28', applied: 'SocialIcons (tooltip above)', url: 'https://uiverse.io/PriyanshuGupta28/chilly-eagle-55' },
  { slug: 'tricky-robin-67', author: 'ElSombrero2', applied: 'ServiceCardFlip (3D flip)', url: 'https://uiverse.io/ElSombrero2/tricky-robin-67' },
  { slug: 'purple-kangaroo-17', author: 'KINGFRESS', applied: 'SplashButton', url: 'https://uiverse.io/KINGFRESS/purple-kangaroo-17' },
];
---

<BaseLayout title="Components lab">
  <section class="container-page section-y">
    <p class="text-sm uppercase tracking-[0.18em] text-(--color-ink-muted)">
      <span class="inline-block w-8 h-px bg-(--color-accent) align-middle mr-2"></span>
      Design system
    </p>
    <h1 class="mt-6">Components lab</h1>
    <p class="mt-6 text-xl text-(--color-ink-muted) max-w-2xl">
      Faithful adaptations of the Uiverse components you selected, recolored to the editorial cálido system.
    </p>
  </section>

  <section class="container-page section-y border-t border-(--color-border)">
    <h2 class="text-3xl">Credits</h2>
    <ul class="mt-10 grid gap-3 max-w-3xl">
      {credits.map((c) => (
        <li class="flex items-baseline justify-between gap-4 py-3 border-b border-(--color-border)">
          <div>
            <a href={c.url} target="_blank" rel="noopener noreferrer" class="font-mono text-sm text-(--color-ink) hover:text-(--color-accent) transition-colors">
              {c.slug}
            </a>
            <span class="text-(--color-ink-subtle) text-sm"> · by {c.author}</span>
          </div>
          <span class="text-sm text-(--color-ink-muted)">{c.applied}</span>
        </li>
      ))}
    </ul>
  </section>

<section class="container-page section-y border-t border-(--color-border)">
      <h2 class="text-3xl">Buttons</h2>
      <p class="mt-3 text-(--color-ink-muted) max-w-xl">Hover each to see the flood, splash and magnetic patterns.</p>
      <div class="mt-12 flex flex-wrap items-center gap-8">
        <SendButton client:visible>Send message</SendButton>
        <SplashButton client:visible>Submit</SplashButton>
        <MagneticButton client:visible>Book appointment</MagneticButton>
      </div>
  </section>

<section class="container-page section-y border-t border-(--color-border)">
      <h2 class="text-3xl">Form controls</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-2 max-w-3xl">
        <AnimatedInput client:visible label="Full name" required />
        <AnimatedInput client:visible label="Email address" type="email" required />
        <AnimatedInput client:visible label="Phone number" type="tel" hint="We'll only call about your appointment." />
        <AnimatedInput client:visible label="Date of birth" type="date" error="Required to verify insurance" />
      </div>

      <div class="mt-10 max-w-3xl">
        <AnimatedTextarea client:visible label="Describe your concern" placeholder="When did it start? What makes it worse?" />
      </div>

      <div class="mt-12 space-y-4 max-w-xl">
        <Checkbox
          client:visible
          label="I consent to be contacted by Wasatch Orthopedic"
          description="We'll only reach out about your appointment — never marketing without permission."
          required
        />
        <Checkbox client:visible label="Send me recovery tips by email" />
      </div>
  </section>

<section class="container-page section-y border-t border-(--color-border)">
      <h2 class="text-3xl">Hover info</h2>
      <p class="mt-4 text-(--color-ink-muted) max-w-xl">Hover the badges below.</p>
      <div class="mt-10 flex flex-wrap gap-6 items-center">
        <Tooltip client:visible content="Board-certified by the American Board of Orthopaedic Surgery">
          <span class="inline-flex items-center gap-1.5 text-sm px-3 py-1.5 rounded-full border border-(--color-border-strong) text-(--color-ink) cursor-help">
            <Info size={14} strokeWidth={1.75} />
            Board certified
          </span>
        </Tooltip>
        <Tooltip client:visible side="bottom" content="Recipient of Utah's 2025 Patient Choice Award for orthopedic care">
          <span class="inline-flex items-center gap-1.5 text-sm px-3 py-1.5 rounded-full border border-(--color-border-strong) text-(--color-ink) cursor-help">
            <Info size={14} strokeWidth={1.75} />
            2025 Patient Choice
          </span>
        </Tooltip>
      </div>
  </section>

<section class="container-page section-y border-t border-(--color-border)">
      <h2 class="text-3xl">Service cards — flip variant</h2>
      <p class="mt-3 text-(--color-ink-muted) max-w-xl">Image on front, description on hover.</p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((s) => (
          <ServiceCardFlip
            image={s.image}
            title={s.title}
            description={s.description}
            href="#"
            learnMoreLabel="Learn more"
          />
        ))}
      </div>
  </section>

<section class="container-page section-y border-t border-(--color-border)">
      <h2 class="text-3xl">Service cards — compact (related)</h2>
      <p class="mt-3 text-(--color-ink-muted) max-w-xl">Used on detail pages for related-services lists.</p>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {services.map((s) => (
          <ServiceCard
            icon={iconMap[s.icon as keyof typeof iconMap]}
            title={s.title}
            description={s.description}
            href="#"
            learnMoreLabel="Learn more"
          />
        ))}
      </div>
  </section>

<section class="container-page section-y border-t border-(--color-border)">
      <h2 class="text-3xl">Social icons with tooltip</h2>
      <p class="mt-3 text-(--color-ink-muted) max-w-xl">Sage fill rises from the bottom; platform name floats above on hover.</p>
      <div class="mt-10">
        <SocialIcons client:visible />
      </div>
  </section>

<section class="container-page section-y border-t border-(--color-border)">
      <h2 class="text-3xl">Frequently asked</h2>
      <div class="mt-10 max-w-3xl">
        <Accordion items={faqItems} defaultOpen="q1" />
      </div>
  </section>
</BaseLayout>
