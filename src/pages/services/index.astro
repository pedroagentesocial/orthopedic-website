---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import LeadFormSection from '../../components/sections/LeadFormSection.astro';
import CTAStrip from '../../components/sections/CTAStrip.astro';
import ServiceCardFlip from '../../components/ui/ServiceCardFlip.tsx';
import { useTranslations } from '../../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);

const services = (await getCollection('services', (e) => e.data.lang === lang))
  .sort((a, b) => a.data.order - b.data.order);

const FALLBACK_IMAGE = 'https://images.unsplash.com/photo-1559757148-5c350d0d3c56?auto=format&fit=crop&w=900&q=80';
---

<BaseLayout title={t('pages.services.metaTitle')} description={t('pages.services.subtitle')}>
  <PageHero
    eyebrow={t('pages.services.eyebrow')}
    title={t('pages.services.title')}
    subtitle={t('pages.services.subtitle')}
  />

  <section class="container-page section-y">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => (
        <ServiceCardFlip
          client:visible
          image={s.data.image ?? FALLBACK_IMAGE}
          title={s.data.title}
          description={s.data.summary}
          href={`/services/${s.data.slug}`}
          learnMoreLabel={t('home.services.learnMore')}
        />
      ))}
    </div>
  </section>

  <LeadFormSection />
  <CTAStrip />
</BaseLayout>
