---
import { ClipboardList, Wallet, Stethoscope, HeartPulse, Check, Calendar, FileText, ShieldCheck, ArrowUpRight } from 'lucide-react';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import LeadFormSection from '../components/sections/LeadFormSection.astro';
import CTAStrip from '../components/sections/CTAStrip.astro';
import { useTranslations, localizePath } from '../i18n/utils';
import en from '../i18n/en.json';

const lang = 'en' as const;
const t = useTranslations(lang);

const firstVisitItems = en.pages.patients.sections.firstVisit.items;
const insurers = en.pages.patients.insurers.list;

const quickActions = [
  { key: 'book',      Icon: Calendar,    href: '/contact' },
  { key: 'insurance', Icon: ShieldCheck, href: '/contact' },
  { key: 'forms',     Icon: FileText,    href: '#' },
] as const;

const sections = [
  { key: 'firstVisit', Icon: ClipboardList, image: 'https://images.unsplash.com/photo-1559757148-5c350d0d3c56?auto=format&fit=crop&w=1200&q=80' },
  { key: 'insurance',  Icon: Wallet,        image: 'https://images.unsplash.com/photo-1576091160550-2173dba999ef?auto=format&fit=crop&w=1200&q=80' },
  { key: 'preop',      Icon: Stethoscope,   image: 'https://images.unsplash.com/photo-1581595220892-b0739db3ba8c?auto=format&fit=crop&w=1200&q=80' },
  { key: 'postop',     Icon: HeartPulse,    image: 'https://images.unsplash.com/photo-1551601651-2a8555f1a136?auto=format&fit=crop&w=1200&q=80' },
] as const;
---

<BaseLayout title={t('pages.patients.metaTitle')} description={t('pages.patients.subtitle')}>
  <PageHero
    eyebrow={t('pages.patients.eyebrow')}
    title={t('pages.patients.title')}
    subtitle={t('pages.patients.subtitle')}
    image="https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?auto=format&fit=crop&w=1200&q=80"
  />

  <!-- Quick actions -->
  <section class="container-page section-y">
    <div class="reveal-up max-w-2xl">
      <p class="text-sm uppercase tracking-[0.18em] text-(--color-ink-muted)">
        <span class="eyebrow-line"></span>
        {t('pages.patients.quickActions.eyebrow')}
      </p>
      <h2 class="mt-6">{t('pages.patients.quickActions.title')}</h2>
    </div>
    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {quickActions.map((action) => {
        const { Icon } = action;
        return (
          <a
            href={localizePath(action.href, lang)}
            class="reveal-up group flex flex-col p-8 rounded-(--radius-lg) border border-(--color-border) bg-(--color-surface-elevated) hover:border-(--color-border-accent) hover:-translate-y-0.5 hover:shadow-(--shadow-md) transition-all duration-300 ease-(--ease-out-expo)"
          >
            <span class="inline-flex h-14 w-14 items-center justify-center rounded-(--radius-md) bg-(--color-accent-subtle) text-(--color-accent) transition-transform duration-500 ease-(--ease-out-expo) group-hover:scale-105">
              <Icon size={26} strokeWidth={1.5} />
            </span>
            <h3
              class="mt-8 font-display text-2xl tracking-tight text-(--color-ink)"
            >
              {t(`pages.patients.quickActions.items.${action.key}.title`)}
            </h3>
            <p class="mt-3 text-(--color-ink-muted) leading-relaxed flex-1">
              {t(`pages.patients.quickActions.items.${action.key}.description`)}
            </p>
            <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-(--color-accent) group-hover:gap-3 transition-all duration-300 ease-(--ease-out-expo)">
              {t(`pages.patients.quickActions.items.${action.key}.cta`)}
              <ArrowUpRight size={16} strokeWidth={1.75} />
            </span>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Detailed sections — alternating side image / text -->
  <section class="container-page section-y border-t border-(--color-border)">
    <div class="reveal-up max-w-2xl">
      <p class="text-sm uppercase tracking-[0.18em] text-(--color-ink-muted)">
        <span class="eyebrow-line"></span>
        {t('pages.patients.eyebrow')}
      </p>
      <h2 class="mt-6">{t('pages.patients.title')}</h2>
    </div>

    <div class="mt-20 space-y-24 md:space-y-32">
      {sections.map((section, i) => {
        const { Icon } = section;
        const isReversed = i % 2 === 1;
        return (
          <article class="reveal-up grid gap-10 md:grid-cols-2 md:gap-16 md:items-center">
            <!-- Text column -->
            <div class={isReversed ? 'md:order-2' : ''}>
              <p class="font-mono text-xs tabular-nums uppercase tracking-[0.2em] text-(--color-ink-subtle)">
                {String(i + 1).padStart(2, '0')} <span class="text-(--color-border-strong)">/</span> {String(sections.length).padStart(2, '0')}
              </p>
              <div class="mt-5 flex items-center gap-4">
                <span class="inline-flex h-12 w-12 items-center justify-center rounded-(--radius-md) bg-(--color-accent-subtle) text-(--color-accent)">
                  <Icon size={24} strokeWidth={1.5} />
                </span>
                <h3
                  class="font-display text-3xl tracking-tight text-(--color-ink)"
                >
                  {t(`pages.patients.sections.${section.key}.title`)}
                </h3>
              </div>
              <p class="mt-6 text-(--color-ink-muted) leading-relaxed">
                {t(`pages.patients.sections.${section.key}.description`)}
              </p>
              {section.key === 'firstVisit' && (
                <ul class="mt-8 space-y-3" role="list">
                  {firstVisitItems.map((item) => (
                    <li class="flex items-start gap-3 text-(--color-ink)">
                      <Check size={16} strokeWidth={1.75} className="text-(--color-accent) mt-1 shrink-0" />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <!-- Image column -->
            <div class={`relative aspect-[4/5] md:aspect-[3/4] overflow-hidden rounded-(--radius-lg) bg-(--color-surface-sunken) ${isReversed ? 'md:order-1' : ''}`}>
              <img
                src={section.image}
                alt=""
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover"
              />
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Insurance accepted -->
  <section class="container-page section-y border-t border-(--color-border)">
    <div class="grid gap-12 lg:grid-cols-[1fr_2fr] lg:gap-16">
      <div class="reveal-up lg:sticky lg:top-28 lg:self-start">
        <p class="text-sm uppercase tracking-[0.18em] text-(--color-ink-muted)">
          <span class="eyebrow-line"></span>
          {t('pages.patients.insurers.eyebrow')}
        </p>
        <h2 class="mt-6">{t('pages.patients.insurers.title')}</h2>
        <p class="mt-6 text-(--color-ink-muted) leading-relaxed">
          {t('pages.patients.insurers.subtitle')}
        </p>
      </div>
      <ul class="reveal-up grid gap-3 grid-cols-2 sm:grid-cols-3 content-start" role="list">
        {insurers.map((insurer) => (
          <li class="flex items-center justify-center px-4 py-5 rounded-(--radius-md) border border-(--color-border) bg-(--color-surface-elevated) text-(--color-ink) font-medium text-center hover:border-(--color-accent) hover:bg-(--color-accent-subtle) transition-all duration-300 ease-(--ease-out-quart) cursor-default">
            {insurer}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <LeadFormSection />
  <CTAStrip />
</BaseLayout>
