---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getLangFromUrl, useTranslations, getAlternateLang, localizePath, type Lang } from '../i18n/utils';
import SiteHeader from '../components/sections/SiteHeader.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import BackToTop from '../components/ui/BackToTop.astro';
import Toaster from '../components/ui/Toaster.tsx';
import { tituloSeo, descripcionSeo } from '../lib/seo-text';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Transparent header fixed over the hero (home only); turns solid on scroll. */
  transparentHeader?: boolean;
}

const { title, description, ogImage, transparentHeader = false, noindex = false } = Astro.props;
const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const siteName = t('meta.siteName');
const defaultDescription = t('meta.siteDescription');
// Sin title (la portada) el título era solo "Orthopedic PI": se agrega el servicio.
const pageTitle = title ? `${title} — ${siteName}` : `${t('meta.homeTitle')} — ${siteName}`;
// JSON-LD de la organización. Sin dirección ni teléfono a propósito: los que hay
// en el sitio (1234 Wasatch Blvd, 801-555-0100) son de relleno y no deben ir a
// Google. Agregarlos cuando estén los datos reales.
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalOrganization',
  '@id': new URL('/#organization', Astro.site).toString(),
  name: siteName,
  url: new URL('/', Astro.site).toString(),
  logo: new URL('/favicon.png', Astro.site).toString(),
  description: defaultDescription,
};
const pageDescription = description ?? defaultDescription;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const alternateLang = getAlternateLang(lang);
const alternateUrl = new URL(localizePath(Astro.url.pathname, alternateLang), Astro.site).toString();
---

<!doctype html>
<html lang={lang} dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{tituloSeo(pageTitle, siteName)}</title>
    <meta name="description" content={descripcionSeo(pageDescription)} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
    <link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname.replace(/^\/es/, '') || '/', Astro.site).toString()} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={t('meta.locale')} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />

    <meta name="theme-color" content="#FCFDFD" />
    <meta name="color-scheme" content="light" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(orgJsonLd)} />
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-(--color-surface-elevated) focus:px-4 focus:py-2 focus:rounded-(--radius-md) focus:shadow-md">
      Skip to content
    </a>
    <SiteHeader overlay={transparentHeader} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
    <BackToTop />
    <Toaster client:idle />

    <script>
      import Lenis from 'lenis';

      let lenis: Lenis | null = null;

      function startLenis() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion) return;
        lenis?.destroy();
        lenis = new Lenis({
          duration: 1.05,
          easing: (t: number) => 1 - Math.pow(2, -10 * t),
          smoothWheel: true,
          touchMultiplier: 1.5,
        });
        function raf(time: number) {
          lenis?.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);
      }

      startLenis();
      document.addEventListener('astro:after-swap', startLenis);
      document.addEventListener('astro:before-swap', () => lenis?.destroy());
    </script>
  </body>
</html>
