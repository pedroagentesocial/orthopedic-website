---
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
import SocialIcons from '../ui/SocialIcons.tsx';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const navItems = [
  { key: 'services', href: '/services' },
  { key: 'conditions', href: '/conditions' },
  { key: 'patients', href: '/patients' },
  { key: 'location', href: '/location' },
  { key: 'about', href: '/about' },
  { key: 'contact', href: '/contact' },
] as const;

const legalItems = [
  { key: 'privacy', href: '#' },
  { key: 'terms', href: '#' },
  { key: 'accessibility', href: '#' },
] as const;
---

<footer class="border-t border-(--color-border) mt-(--spacing-section)">
  <div class="container-page py-12 flex flex-col gap-10 md:flex-row md:items-center md:justify-between md:gap-8">
    <a
      href={localizePath('/', lang)}
      class="shrink-0 transition-opacity hover:opacity-80"
    >
      <img
        src="/images/logo-lockup.png"
        alt={t('meta.siteName')}
        class="h-16 w-auto"
        width="759"
        height="454"
        loading="lazy"
      />
    </a>

    <nav class="flex flex-wrap gap-x-6 gap-y-2 md:justify-center" aria-label="Footer">
      {navItems.map((item) => (
        <a
          href={localizePath(item.href, lang)}
          class="text-sm font-medium text-(--color-ink-muted) rounded-(--radius-sm) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
        >
          <span class="link-swap">
            <span class="link-swap__inner">
              <span class="link-swap__top">{t(`nav.${item.key}`)}</span>
              <span class="link-swap__bottom">{t(`nav.${item.key}`)}</span>
            </span>
          </span>
        </a>
      ))}
    </nav>

    <div class="md:flex md:justify-end">
      <SocialIcons client:visible />
    </div>
  </div>

  <div class="border-t border-(--color-border)">
    <div
      class="container-page py-5 flex flex-col gap-3 md:flex-row md:justify-between md:items-center text-sm text-(--color-ink-subtle)"
    >
      <p>© {year} Orthopedic PI. {t('footer.rights')}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2" role="list">
        {legalItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="underline-grow hover:text-(--color-ink) transition-colors duration-200 ease-(--ease-out-quart)"
            >
              {t(`footer.legal.${item.key}`)}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>
