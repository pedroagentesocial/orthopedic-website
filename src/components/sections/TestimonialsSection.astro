---
import { Quote } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import GoogleBadge from '../ui/GoogleBadge.tsx';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const keys = ['one', 'two', 'three'] as const;
const items = keys.map((k) => ({
  quote: t(`home.testimonials.items.${k}.quote`),
  name: t(`home.testimonials.items.${k}.name`),
  treatment: t(`home.testimonials.items.${k}.treatment`),
  date: t(`home.testimonials.items.${k}.date`),
}));
---

<section class="container-page section-y border-t border-(--color-border)">
  <div class="reveal-up text-center max-w-2xl mx-auto">
    <p class="text-sm uppercase tracking-[0.18em] text-(--color-ink-muted)">
      <span class="inline-block w-8 h-px bg-(--color-accent) align-middle mr-2"></span>
      {t('home.testimonials.eyebrow')}
      <span class="inline-block w-8 h-px bg-(--color-accent) align-middle ml-2"></span>
    </p>
    <h2 class="mt-6 text-balance">{t('home.testimonials.title')}</h2>
    <p class="mt-6 text-lg text-(--color-ink-muted) leading-relaxed">
      {t('home.testimonials.subtitle')}
    </p>
  </div>

  <ul role="list" class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {items.map((item) => (
      <li class="reveal-up">
        <article class="h-full flex flex-col p-8 rounded-(--radius-lg) border border-(--color-border) bg-(--color-surface-elevated) transition-colors duration-200 hover:border-(--color-border-strong)">
          <header class="flex items-start justify-between gap-4 pb-6 border-b border-(--color-border)">
            <GoogleBadge client:visible rating={5} />
            <span class="text-xs text-(--color-ink-subtle) tabular-nums whitespace-nowrap pt-1">
              {item.date}
            </span>
          </header>

          <div class="mt-6 flex-1">
            <Quote
              size={28}
              strokeWidth={1.25}
              className="text-(--color-accent) opacity-50"
              aria-hidden="true"
            />
            <blockquote
              class="mt-4 font-display text-lg leading-relaxed text-(--color-ink) text-pretty"
              style={{ fontVariationSettings: '"opsz" 36' }}
            >
              "{item.quote}"
            </blockquote>
          </div>

          <footer class="mt-8 pt-6 border-t border-(--color-border)">
            <p class="font-medium text-(--color-ink)">{item.name}</p>
            <p class="mt-1 text-sm text-(--color-ink-muted)">{item.treatment}</p>
            <p class="mt-3 text-xs uppercase tracking-wider text-(--color-ink-subtle)">
              {t('home.testimonials.source')}
            </p>
          </footer>
        </article>
      </li>
    ))}
  </ul>
</section>
