---
import { Quote, MapPin } from 'lucide-react';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import GoogleBadge from '../ui/GoogleBadge.tsx';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const keys = ['one', 'two', 'three', 'four', 'five', 'six', 'seven', 'eight', 'nine'] as const;
const items = keys.map((k) => ({
  quote: t(`home.testimonials.items.${k}.quote`),
  name: t(`home.testimonials.items.${k}.name`),
  treatment: t(`home.testimonials.items.${k}.treatment`),
  date: t(`home.testimonials.items.${k}.date`),
  location: t(`home.testimonials.items.${k}.location`),
}));

// Distribute 9 cards into 3 columns (round-robin so visually balanced)
const col1 = [items[0], items[3], items[6]];
const col2 = [items[1], items[4], items[7]];
const col3 = [items[2], items[5], items[8]];
const columns = [
  { items: col1, direction: 'up' as const },
  { items: col2, direction: 'down' as const },
  { items: col3, direction: 'up' as const },
];
---

<section class="container-page section-y border-t border-(--color-border)">
  <div class="reveal-up text-center max-w-2xl mx-auto">
    <p class="text-sm uppercase tracking-[0.18em] text-(--color-ink-muted)">
      <span class="inline-block w-8 h-px bg-(--color-accent) align-middle mr-2"></span>
      {t('home.testimonials.eyebrow')}
      <span class="inline-block w-8 h-px bg-(--color-accent) align-middle ml-2"></span>
    </p>
    <h2 class="mt-6 text-balance">{t('home.testimonials.title')}</h2>
    <p class="mt-6 text-lg text-(--color-ink-muted) leading-relaxed">
      {t('home.testimonials.subtitle')}
    </p>
  </div>

  <!-- Desktop / tablet: 3-column scrolling wall -->
  <div class="tw-wall mt-16 hidden md:block" style="height: 720px;">
    <div class="tw-grid">
      {columns.map((col) => (
        <div class={`tw-col tw-col-${col.direction}`}>
          {/* Render items twice for seamless infinite loop */}
          {[...col.items, ...col.items].map((item, i) => (
            <article
              class="flex flex-col p-6 rounded-(--radius-lg) border border-(--color-border) bg-(--color-surface-elevated)"
              aria-hidden={i >= col.items.length ? 'true' : undefined}
            >
              <header class="flex items-start justify-between gap-4 pb-4 border-b border-(--color-border)">
                <GoogleBadge rating={5} />
                <span class="text-xs text-(--color-ink-subtle) tabular-nums whitespace-nowrap pt-1">
                  {item.date}
                </span>
              </header>

              <div class="mt-4 flex-1">
                <Quote
                  size={20}
                  strokeWidth={1.25}
                  className="text-(--color-accent) opacity-60"
                  aria-hidden="true"
                />
                <blockquote
                  class="mt-3 text-sm leading-relaxed text-(--color-ink) text-pretty"
                >
                  "{item.quote}"
                </blockquote>
              </div>

              <footer class="mt-5 pt-4 border-t border-(--color-border) space-y-1">
                <p class="font-medium text-(--color-ink) text-sm">{item.name}</p>
                <p class="text-xs text-(--color-ink-muted)">{item.treatment}</p>
                <p class="flex items-center gap-1.5 text-xs text-(--color-ink-subtle) pt-1">
                  <MapPin size={11} strokeWidth={1.75} aria-hidden="true" />
                  {item.location}
                </p>
              </footer>
            </article>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- Mobile fallback: simple grid, no animation -->
  <ul role="list" class="mt-16 grid gap-4 md:hidden">
    {items.map((item) => (
      <li>
        <article class="flex flex-col p-6 rounded-(--radius-lg) border border-(--color-border) bg-(--color-surface-elevated)">
          <header class="flex items-start justify-between gap-4 pb-4 border-b border-(--color-border)">
            <GoogleBadge rating={5} />
            <span class="text-xs text-(--color-ink-subtle) tabular-nums whitespace-nowrap pt-1">
              {item.date}
            </span>
          </header>
          <blockquote class="mt-4 text-sm leading-relaxed text-(--color-ink)">
            "{item.quote}"
          </blockquote>
          <footer class="mt-5 pt-4 border-t border-(--color-border) space-y-1">
            <p class="font-medium text-(--color-ink) text-sm">{item.name}</p>
            <p class="text-xs text-(--color-ink-muted)">{item.treatment}</p>
            <p class="flex items-center gap-1.5 text-xs text-(--color-ink-subtle) pt-1">
              <MapPin size={11} strokeWidth={1.75} aria-hidden="true" />
              {item.location}
            </p>
          </footer>
        </article>
      </li>
    ))}
  </ul>
</section>
