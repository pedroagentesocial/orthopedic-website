---
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
import LanguageSwitcher from '../i18n/LanguageSwitcher.astro';
import FoldButton from '../ui/FoldButton.astro';
import MobileMenu from './MobileMenu.astro';

interface Props {
  /** Fixed + transparent over a dark full-screen hero (home). Turns solid on scroll. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { key: 'services', href: '/services' },
  { key: 'conditions', href: '/conditions' },
  { key: 'patients', href: '/patients' },
  { key: 'faq', href: '/#faq' },
  { key: 'about', href: '/about' },
] as const;
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
  <div class="container-page flex items-center justify-between h-20">
    <a
      href={localizePath('/', lang)}
      class="sh-logo shrink-0 transition-opacity hover:opacity-80"
    >
      <img
        src="/images/logo-lockup.png"
        alt={t('meta.siteName')}
        class="h-14 w-auto"
        width="759"
        height="454"
      />
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
      {navItems.map((item) => (
        <a
          href={localizePath(item.href, lang)}
          class="px-3 py-2 text-sm font-medium text-(--color-ink-muted) rounded-(--radius-sm) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
        >
          <span class="link-swap">
            <span class="link-swap__inner">
              <span class="link-swap__top">{t(`nav.${item.key}`)}</span>
              <span class="link-swap__bottom">{t(`nav.${item.key}`)}</span>
            </span>
          </span>
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <div class="sh-lang hidden lg:block">
        <LanguageSwitcher />
      </div>
      {/* Wrapper div hides the CTA <lg — .fold-btn's own display rule is
          unlayered CSS and would beat Tailwind's `hidden` utility directly */}
      <div class="hidden lg:block">
        <FoldButton href={localizePath('/contact', lang)}>
          {t('nav.book')}
        </FoldButton>
      </div>
      <MobileMenu />
    </div>
  </div>
</header>

<script>
  // Overlay header (home): transparent over the hero, solid once the visitor
  // scrolls near the hero's end. Single global listener — the header element
  // is re-queried on every tick so Astro view transitions stay in sync.
  function updateOverlayHeader() {
    const header = document.querySelector('.site-header--overlay');
    if (!header) return;
    const threshold = Math.max(window.innerHeight - 120, 160);
    header.classList.toggle('site-header--scrolled', window.scrollY > threshold);
  }

  if (document.documentElement.dataset.shOverlayBound !== '1') {
    document.documentElement.dataset.shOverlayBound = '1';
    window.addEventListener('scroll', updateOverlayHeader, { passive: true });
    window.addEventListener('resize', updateOverlayHeader);
    document.addEventListener('astro:page-load', updateOverlayHeader);
  }
  updateOverlayHeader();
</script>
