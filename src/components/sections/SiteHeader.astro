---
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
import LanguageSwitcher from '../i18n/LanguageSwitcher.astro';
import FoldButton from '../ui/FoldButton.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navItems = [
  { key: 'services', href: '/services' },
  { key: 'conditions', href: '/conditions' },
  { key: 'patients', href: '/patients' },
  { key: 'faq', href: '/#faq' },
  { key: 'about', href: '/about' },
] as const;
---

<header
  class="sticky top-0 z-40 bg-(--color-surface)/85 backdrop-blur-md border-b border-(--color-border)"
>
  <div class="container-page flex items-center justify-between h-20">
    <a
      href={localizePath('/', lang)}
      class="font-display text-xl tracking-tight text-(--color-ink) hover:text-(--color-accent) transition-colors"
      aria-label={t('meta.siteName')}
    >
      Orthopedic <span class="text-(--color-accent)">PI</span>
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label="Primary">
      {navItems.map((item) => (
        <a
          href={localizePath(item.href, lang)}
          class="px-3 py-2 text-sm font-medium text-(--color-ink-muted) rounded-(--radius-sm) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
        >
          <span class="link-swap">
            <span class="link-swap__inner">
              <span class="link-swap__top">{t(`nav.${item.key}`)}</span>
              <span class="link-swap__bottom">{t(`nav.${item.key}`)}</span>
            </span>
          </span>
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher />
      <FoldButton href={localizePath('/contact', lang)} class="hidden sm:inline-flex">
        {t('nav.book')}
      </FoldButton>
    </div>
  </div>
</header>
