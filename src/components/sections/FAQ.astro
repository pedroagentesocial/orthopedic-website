---
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
import Accordion from '../ui/Accordion.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const keys = ['referral', 'insurance', 'wait', 'imaging'] as const;
const items = keys.map((k) => ({
  value: k,
  question: t(`home.faq.items.${k}.q`),
  answer: t(`home.faq.items.${k}.a`),
}));
---

<section id="faq" class="container-page section-y border-t border-(--color-border) scroll-mt-24">
  <div class="grid gap-12 lg:grid-cols-[1fr_2fr] lg:gap-20">
    <div class="reveal-up">
      <p class="text-sm uppercase tracking-[0.18em] text-(--color-ink-muted)">
        <span class="eyebrow-line"></span>
        {t('home.faq.eyebrow')}
      </p>
      <h2 class="mt-6">{t('home.faq.title')}</h2>
      <p class="mt-6 text-(--color-ink-muted)">
        <a
          href={localizePath('/patients', lang)}
          class="underline-grow hover:text-(--color-accent) transition-colors"
        >
          {t('actions.learnMore')}
        </a>
      </p>
    </div>
    <div class="reveal-up">
      <Accordion items={items} defaultOpen="referral" />
    </div>
  </div>
</section>
