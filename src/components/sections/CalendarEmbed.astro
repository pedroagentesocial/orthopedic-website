---
import { CalendarClock } from 'lucide-react';

interface Props {
  title: string;
  subtitle: string;
  fallbackMessage: string;
}

const { title, subtitle, fallbackMessage } = Astro.props;
const calendarUrl = import.meta.env.PUBLIC_GHL_CALENDAR_URL;
---

<section
  class="container-page section-y border-t border-(--color-border)"
  aria-labelledby="calendar-heading"
>
  <div class="grid gap-12 lg:grid-cols-[1fr_2fr] lg:gap-16">
    <div>
      <p class="text-sm uppercase tracking-[0.18em] text-(--color-ink-muted)">
        <span class="inline-block w-8 h-px bg-(--color-accent) align-middle mr-2"></span>
        <CalendarClock size={14} strokeWidth={1.5} className="inline-block align-middle ml-1 text-(--color-accent)" />
      </p>
      <h2 id="calendar-heading" class="mt-6">{title}</h2>
      <p class="mt-6 text-(--color-ink-muted) leading-relaxed">{subtitle}</p>
    </div>

    {calendarUrl ? (
      <div class="overflow-hidden rounded-(--radius-2xl) border border-(--color-border) bg-(--color-surface-elevated)">
        <iframe
          src={calendarUrl}
          title={title}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="block w-full min-h-[640px] border-0"
        ></iframe>
      </div>
    ) : (
      <div class="flex flex-col items-center justify-center text-center min-h-[400px] rounded-(--radius-2xl) border border-dashed border-(--color-border-strong) bg-(--color-surface-sunken) p-12">
        <div class="inline-flex h-14 w-14 items-center justify-center rounded-full bg-(--color-accent-subtle) text-(--color-accent)">
          <CalendarClock size={26} strokeWidth={1.5} />
        </div>
        <p class="mt-6 max-w-sm text-(--color-ink-muted) leading-relaxed">
          {fallbackMessage}
        </p>
      </div>
    )}
  </div>
</section>
