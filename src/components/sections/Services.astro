---
import { getLangFromUrl, useTranslations, localizePath } from '../../i18n/utils';
import ServiceCardFlip from '../ui/ServiceCardFlip.tsx';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  { key: 'knee',     image: '/images/knee-hip-service.jpg' },
  { key: 'spine',    image: '/images/spine-service.jpg' },
  { key: 'shoulder', image: '/images/elbow-shoulder-service.jpg' },
  { key: 'hand',     image: '/images/hand-wrist-service.jpg' },
  { key: 'sports',   image: '/images/sport-medicine-service.jpg' },
  { key: 'joint',    image: '/images/joint-treatment.jpg' },
] as const;
---

<section class="container-page section-y border-t border-(--color-border)">
  <div class="grid gap-12 lg:grid-cols-[1fr_2fr] lg:gap-20">
    <div class="lg:sticky lg:top-28 lg:self-start reveal-up">
      <p class="text-sm uppercase tracking-[0.18em] text-(--color-ink-muted)">
        <span class="eyebrow-line"></span>
        {t('home.services.eyebrow')}
      </p>
      <h2 class="mt-6">{t('home.services.title')}</h2>
      <p class="mt-6 text-lg text-(--color-ink-muted) leading-relaxed">
        {t('home.services.subtitle')}
      </p>
      <a
        href={localizePath('/services', lang)}
        class="services-cta mt-8 inline-flex items-center gap-2 text-(--color-accent) font-medium"
      >
        <span class="underline-grow">{t('home.services.viewAll')}</span>
        <span aria-hidden="true" class="services-cta__arrow transition-transform duration-300 ease-(--ease-out-expo)">→</span>
      </a>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      {services.map(({ key, image }) => (
        <div class="reveal-up">
          <ServiceCardFlip
            image={image}
            title={t(`home.services.${key}.title`)}
            description={t(`home.services.${key}.description`)}
            href={localizePath(`/services/${key}`, lang)}
            learnMoreLabel={t('home.services.learnMore')}
          />
        </div>
      ))}
    </div>
  </div>
</section>
