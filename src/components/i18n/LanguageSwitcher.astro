---
import { getLangFromUrl, getAlternateLang, localizePath, useTranslations, languages } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const alternateLang = getAlternateLang(lang);
const alternatePath = localizePath(Astro.url.pathname, alternateLang);
const t = useTranslations(lang);
const label = t('actions.switchLanguage');
---

<a
  href={alternatePath}
  hreflang={alternateLang}
  lang={alternateLang}
  class="inline-flex items-center gap-1.5 text-sm font-medium text-(--color-ink-muted) px-3 py-1.5 rounded-(--radius-sm) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--color-accent)"
  aria-label={`Switch to ${languages[alternateLang]}`}
>
  <span aria-hidden="true" class="text-(--color-ink-subtle) uppercase tracking-wider text-xs">
    {alternateLang}
  </span>
  <span class="link-swap">
    <span class="link-swap__inner">
      <span class="link-swap__top">{label}</span>
      <span class="link-swap__bottom">{label}</span>
    </span>
  </span>
</a>
