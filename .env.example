# ── Server-only variables (NOT exposed to the browser) ───────────────────────

# GoHighLevel inbound webhook — receives lead form submissions. Used ONLY by the
# server route src/pages/api/lead.ts, so it never reaches the client bundle.
# Optional: a default hook is baked into the code; set this to point at a
# different CRM/location. Do NOT prefix with PUBLIC_.
GHL_WEBHOOK_URL=

# ── Public variables (inlined into the client bundle; prefix with PUBLIC_) ────

# GoHighLevel calendar widget URL — embedded as iframe on the /contact page.
# In GHL: Calendars → your calendar → Share → Embed code → copy the src URL.
# Example: https://api.leadconnectorhq.com/widget/booking/<your-calendar-id>
PUBLIC_GHL_CALENDAR_URL=

# Site URL (used for canonical URLs, sitemap, OG meta).
# Use http://localhost:4321 for local dev, https://orthopedicpi.com in production.
PUBLIC_SITE_URL=https://orthopedicpi.com

# Optional looping background video for the homepage hero (mp4 direct URL).
# When empty, the hero shows the poster image full-screen. Provide your own
# stock clip (Pexels/Coverr) or self-hosted file in your CDN.
PUBLIC_HERO_VIDEO_URL=
